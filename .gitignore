# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw design assets & heavy media sources
Fotos_productos/
*.cdr

# local strategy docs & drafts
resumen_estrategia_y_tienda.html
fidelizacion/

# internal audit reports (generated output, not code — keep these out of git)
INFORME_TECNICO_*.pdf
MANUAL_*.pdf
*.csv
EXCELS POR INTEGRAR/

# scripts/: the code (.ts/.py/.js) IS tracked on purpose — these are one-time or repeatable
# production data migrations (Kommo, ventas, schema fixes) and need git history/audit trail.
# Only the raw data dumps they read/write stay out, since those are large, regenerable, and
# often contain full customer exports that don't belong in version control.
scripts/data/



# generated at build time (scripts/generate-jpg-images.mjs)
/public/images-jpg
