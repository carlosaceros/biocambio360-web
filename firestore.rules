rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders collection. El checkout anónimo SÍ necesita crear pedidos (siempre arrancan en
    // 'pendiente' -- src/app/checkout/page.tsx), así que `create` se queda público pero forzado
    // a ese estado inicial: evita que alguien escriba directo un pedido ya 'confirmado' (fraude
    // de referidos/stock/prueba social) sin pasar por Wompi. Un pedido autenticado desde /admin
    // (FastOrderModal: 'borrador'/'confirmado'/'guardado'/'descartado' para ventas telefónicas)
    // sigue permitido vía el OR de `request.auth != null`.
    //
    // `update` se restringe a solo-autenticado: ya NO depende de que el checkout anónimo pueda
    // reescribir el pedido (nunca lo hizo), y los 5 llamadores de servidor que sí necesitan
    // cambiar el estado sin sesión de navegador (webhooks de Wompi/Addi/99 Envíos, importación de
    // reportes de envío, y el fallback /api/admin/wompi-status que consulta la página de
    // confirmación) ya fueron migrados a Admin SDK, que no depende de estas reglas. Antes, un
    // `updateDoc` anónimo directo podía forjar `status: 'confirmado'` en cualquier pedido
    // existente sin haber pagado.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.status == 'pendiente';
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Customers collection
    match /customers/{customerId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // B2B Proposals collection
    match /b2b_proposals/{proposalId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Customer Replenishments collection
    match /customer_replenishments/{replenishmentId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Abandoned carts: created/updated from checkout (anónimo) y desde los links de
    // recuperación por WhatsApp/email — mismo criterio que orders/customers arriba.
    // Vivía sin regla propia (dependía del catch-all); se hace explícito para que quede
    // documentado como excepción intencional, no accidental.
    match /abandoned_carts/{cartId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Wheel Config: el modal público solo LEE la configuración (premios, vigencia) por
    // onSnapshot; nada público escribe aquí — solo /admin/* edita los premios.
    match /wheel_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Wheel Spins: se escriben solo desde /api/coupons/wheel-spin (servidor), que hoy usa
    // el SDK de cliente sin sesión — por eso create/update siguen abiertos hasta migrar esa
    // ruta al Admin SDK (ver TODO en ese archivo). Lectura sí se restringe: nadie público
    // necesita ver los giros de otros clientes.
    match /wheel_spins/{spinId} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Promo Modal Config: igual que wheel_config — solo lectura pública (subscribePromoConfig),
    // la edición es exclusiva de /admin/*.
    match /promo_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Referral program: perfil, transacciones y auditoría de saldo. El checkout anónimo
    // necesita crear/actualizar el perfil y registrar la transacción al aplicar un código de
    // referido — quedó sin regla propia al cerrar el catch-all abierto (commit 0e1ba61), lo
    // que rompió en producción la validación y el registro de referidos (confirmado en vivo:
    // /api/referrals/lookup devolvía "Missing or insufficient permissions"). Mismo criterio
    // que orders/customers: público para create/update, solo auth para delete.
    match /referral_profiles/{profileId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
    match /referral_transactions/{transactionId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
    match /referral_balance_audit_logs/{logId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Coupons collection
    match /coupons/{couponId} {
      allow read, create, update: if true;
    }
    match /coupon_redemptions/{redemptionId} {
      allow read, create, update: if true;
    }

    // Products collection: el catálogo es público para lectura (tienda, blog, páginas SEO).
    // La suposición original ("nada público escribe aquí, solo /admin") era incorrecta: el
    // checkout anónimo SÍ necesita descontar/restituir stock en cada venta (decrementStockFor
    // OrderItems / incrementStockForOrderItems en orders-service.ts), vía updateProductStock(),
    // que solo toca los campos `stock` y `updatedAt`. Cerrar `write` a solo-auth esta mañana
    // rompió en silencio ese descuento de inventario (confirmado: escritura anónima de prueba
    // devolvía permission-denied) sin bloquear la venta en sí (el error queda en un catch), lo
    // que habría llevado a sobreventa por conteos de stock nunca actualizados.
    // Precio/nombre/imágenes/etc. siguen exigiendo sesión — solo se abre esa combinación exacta
    // de campos para escritura anónima.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
    }

    // ── Inbox / Messaging Collections ─────────────────────────────────────────
    // conversations: written by Admin SDK (webhook), read by authenticated admin users
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null;
      allow create: if false; // created only via Admin SDK (webhook server-side)
      allow delete: if false;

      // messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if false; // created only via Admin SDK (webhook or /api/inbox/send)
        allow update: if false;
        allow delete: if false;
      }
    }

    // bulk reminder audit log — read by admins, write via Admin SDK only
    match /bulk_reminder_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // WhatsApp operational alerts (plantillas rechazadas/calidad, calidad de numero)
    // created only by the webhook (Admin SDK); admins can only acknowledge (update)
    match /whatsapp_alerts/{alertId} {
      allow read, update: if request.auth != null;
      allow create: if false;
      allow delete: if false;
    }
    
    // Default para TODO lo demás (admin_users, ai_training, referral_*, pos_sales, audit_logs,
    // user_sessions, las colecciones de staging de migración de Kommo/ventas, crm_activities,
    // etc.): antes era "if true" — abierto a cualquiera en internet sin sesión, sin importar el
    // nombre de la colección. Ahora exige al menos una sesión de Firebase Auth (cualquier cuenta
    // de /admin). Ninguna colección genuinamente pública depende de este catch-all: todas las que
    // de verdad necesitan escritura anónima (orders, customers, abandoned_carts, b2b_proposals,
    // customer_replenishments, coupons, wheel_spins) tienen su propia regla explícita arriba.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
