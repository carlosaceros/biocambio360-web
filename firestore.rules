rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders collection
    match /orders/{orderId} {
      allow create, read, update: if true;
      allow delete: if request.auth != null;
    }
    
    // Customers collection
    match /customers/{customerId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // B2B Proposals collection
    match /b2b_proposals/{proposalId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Customer Replenishments collection
    match /customer_replenishments/{replenishmentId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Wheel Config & Spins collections
    match /wheel_config/{configId} {
      allow read, write: if true;
    }
    match /wheel_spins/{spinId} {
      allow read, create, update: if true;
    }

    // Promo Modal Config collection
    match /promo_config/{configId} {
      allow read, write: if true;
    }

    // Coupons collection
    match /coupons/{couponId} {
      allow read, create, update: if true;
    }
    match /coupon_redemptions/{redemptionId} {
      allow read, create, update: if true;
    }
    
    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Default: allow read/write for operational collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
